{
  "name": "streamvault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/precompress-assets.mjs",
    "build:wgt": "tsc -b && vite build --mode tizen",
    "build:tizen5": "tsc -b && vite build --mode tizen5",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke:api": "node scripts/smoke-api.mjs",
    "typecheck": "tsc -b",
    "typecheck:compat": "tsc6 -b --force",
    "sign": "npm run build && node scripts/sign-wgt.cjs",
    "sign:tizen5": "npm run build:tizen5 && node scripts/sign-wgt.cjs",
    "deploy": "node scripts/sign-wgt.cjs && ./scripts/deploy-tv.sh"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "mpegts.js": "1.8.2",
    "preact": "11.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "abortcontroller-polyfill": "1.7.8",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "20.14.6",
    "postcss": "8.5.29",
    "postcss-preset-env": "11.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "serialize-javascript": "7.1.2"
  }
}
