{
  "name": "streamvault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wgt": "tsc -b && vite build --mode tizen",
    "build:tizen5": "tsc -b && vite build --mode tizen5",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke:api": "node scripts/smoke-api.mjs",
    "typecheck": "tsc -b",
    "sign": "npm run build && node scripts/sign-wgt.cjs",
    "sign:tizen5": "npm run build:tizen5 && node scripts/sign-wgt.cjs",
    "deploy": "node scripts/sign-wgt.cjs && ./scripts/deploy-tv.sh"
  },
  "dependencies": {
    "mpegts.js": "1.8.2",
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "abortcontroller-polyfill": "1.7.8",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.3",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.1",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "serialize-javascript": "7.0.5"
  }
}
